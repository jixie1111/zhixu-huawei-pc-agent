# Copy to .env locally. Never commit real credentials.
HOST=127.0.0.1
PORT=3000
IMA_OPENAPI_CLIENTID=
IMA_OPENAPI_APIKEY=
IMA_KB_NAME=任德耀新建华为PC知识库
IMA_SKILL_PATH=vendor/ima-skills/ima-skill/ima_api.cjs
LLM_BASE_URL=https://api.siliconflow.cn/v1
LLM_MODEL=
LLM_API_KEY=
# Optional reasoning profile: low / medium / high / xhigh / max.
# For gpt-6.1-sol light testing, set low. Leave empty for temperature-based providers.
# Runtime /api/settings can override this non-secret option; restarting clears that override.
LLM_REASONING_EFFORT=
# Local use only: explicitly authorize one exact loopback model endpoint.
# Example shape: http://localhost:55460/v1. Keep empty for remote providers.
LOCAL_LLM_BASE_URL=
# Required when exposing a public server. Write access is disabled without it.
ADMIN_TOKEN=
PUBLIC_DEPLOYMENT=false
# Explicit, manifest-verified knowledge and work-record release; never private/.
# For a released checkout use npm run start:published (after npm run build).
PUBLISHED_DATA_DIR=
# Public mode only: the actual HTTPS origin of the application, not the portal page.
# Example shape: https://your-app.example.com (no path, wildcard or credentials).
# Keep empty locally. Public browser writes are denied until this is configured.
PUBLIC_ORIGIN=
# Optional public iframe parents: comma-separated exact HTTPS origins, maximum 8.
# Leave empty to deny framing. Never use * or a wildcard subdomain.
# Only after verifying the real parent page, e.g. https://modelscope.cn.
FRAME_ANCESTORS=
