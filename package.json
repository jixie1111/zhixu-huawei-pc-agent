{
  "name": "zhixu-marketing-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.13" },
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "build": "tsc --noEmit && vite build",
    "build:demo": "tsx scripts/build-demo.ts",
    "preview:demo": "vite preview --outDir dist-demo --host 127.0.0.1 --port 4174 --strictPort",
    "package:demo": "tsx scripts/stage-demo.ts",
    "start": "tsx server/index.ts --production",
    "start:published": "tsx scripts/start-published.ts",
    "package:authorized": "tsx scripts/package-authorized-data.ts --authorized",
    "start:local": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/local-recording.ps1 -Mode Start",
    "check:local": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/local-recording.ps1 -Mode Check",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "npm run test:e2e:desktop && npm run test:e2e:mobile",
    "test:e2e:desktop": "playwright test --project=desktop",
    "test:e2e:mobile": "playwright test --project=mobile",
    "check": "npm run build && npm test",
    "knowledge:inspect": "tsx scripts/inspect-knowledge.ts",
    "package:preview": "tsx scripts/package-preview.ts",
    "demo:offline": "tsx scripts/prepare-offline-demo.ts --prepare",
    "demo:verify": "tsx scripts/verify-offline-demo.ts"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "csv-parse": "^7.0.3",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "fflate": "0.8.3",
    "playwright": "1.64.1",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "vite": "^7.1.0"
  }
}
